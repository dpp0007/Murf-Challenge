# LiveKit (real-time audio transport)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# Murf (Text-to-Speech)
MURF_API_KEY=your_murf_api_key_here

# Deepgram (Speech-to-Text)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Google Gemini (LLM)
GOOGLE_API_KEY=your_google_api_key_here

# Optional: OpenAI (if using instead of Gemini)
# OPENAI_API_KEY=your_openai_api_key_here

# Outbound Weather Alert Calling (Optional)
OUTBOUND_CALL_ENABLED=false
LIVEKIT_SIP_TRUNK_ID=your_sip_trunk_id_here
LINPHONE_SIP_URI=username@sip.linphone.org
WEATHER_ALERT_DEMO_DISTRICT=Varanasi
# Discord Integration for Escalations (Optional)
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_discord_guild_id_here
DISCORD_ESCALATION_CHANNEL_ID=your_escalation_channel_id_here
DISCORD_RESOLVED_CHANNEL_ID=your_resolved_channel_id_here
DISCORD_HIGH_PRIORITY_CHANNEL_ID=your_high_priority_channel_id_here
DISCORD_ADVISER_ROLE_ID=your_adviser_role_id_here

# Escalation Callback Settings (Optional)
CALLBACK_MAX_RETRIES=2
