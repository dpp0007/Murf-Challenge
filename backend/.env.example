# LiveKit (real-time audio transport)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# Murf (Text-to-Speech)
MURF_API_KEY=your_murf_api_key_here

# Deepgram (Speech-to-Text)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Google Gemini (LLM)
GOOGLE_API_KEY=your_google_api_key_here

# Optional: OpenAI (if using instead of Gemini)
# OPENAI_API_KEY=your_openai_api_key_here

# Outbound Weather Alert Calling (Optional)
OUTBOUND_CALL_ENABLED=false
LIVEKIT_SIP_TRUNK_ID=your_sip_trunk_id_here
LINPHONE_SIP_URI=username@sip.linphone.org
WEATHER_ALERT_DEMO_DISTRICT=Varanasi
